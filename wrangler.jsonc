{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diha-webseite",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  // Täglich 05:15 UTC: Fristen-Erinnerungen, Mahnstatus, Löschfristen
  "triggers": { "crons": ["15 5 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diha",
      // Nach `wrangler d1 create diha --jurisdiction eu` die echte ID eintragen
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "diha-files",
      "jurisdiction": "eu"
    }
  ],
  "vars": {
    "SITE_URL": "http://localhost:5173",
    "MAIL_FROM": "DIHA <noreply@example.com>",
    "INITIAL_ADMINS": "lerch@gl-ventures.at,graf@gl-ventures.at"
  },
  "observability": { "enabled": true }
}
